{
	"version": 1,
	"base_image": "codeocean/omix-r-pathway:r4.4.3-bioconductor3.20-v1",
	"post_install": true,
	"options": {
		"registry_host_arg": true,
		"git_ask_pass": true,
		"mount_secrets": true
	},
	"installers": {
		"rcran": {
			"packages": [
				{
					"name": "RCurl",
					"version": "1.98-1.19"
				}
			],
			"use_rcache": true
		}
	}
}